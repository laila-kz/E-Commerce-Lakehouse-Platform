FROM apache/airflow:2.8.1-python3.10

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

USER airflow
RUN pip install --no-cache-dir \
    dbt-core==1.8.8 \
    dbt-duckdb==1.8.4 \
    dbt-adapters==1.11.0 \
    boto3 \
    tenacity \
    python-dotenv \
    requests \
    openlineage-python \
    apache-airflow-providers-openlineage
